{
  "$schema": "./node_modules/@komari-monitor/plugin-sdk/schema/komari-plugin.schema.json",
  "name": {
    "zh_CN": "Komari DDNS",
    "en": "Komari DDNS"
  },
  "short": "cf-ddns",
  "description": {
    "zh_CN": "根据 Komari 节点上报的公网 IP，自动更新 Cloudflare 和腾讯云 DNSPod 解析记录，实现动态域名解析。",
    "en": "Automatically update Cloudflare and Tencent Cloud DNSPod records from the public IP reported by a Komari node, providing dynamic DNS."
  },
  "author": "穿云箭",
  "version": "0.2.0",
  "komari": ">=1.4.0",
  "entry": "script.js",
  "permissions": {
    "node": true,
    "allowSystemRPC": true,
    "allowRoutes": true,
    "maxHTTPBodyBytes": 4194304,
    "timeout": 30
  },
  "configuration": {
    "type": "managed",
    "data": [
      {
        "key": "api_token",
        "name": { "zh_CN": "Cloudflare API Token", "en": "Cloudflare API Token" },
        "type": "string",
        "help": {
          "zh_CN": "Cloudflare 记录使用的 API Token，需具备 Zone:DNS:Edit 权限。",
          "en": "API token for Cloudflare records. Requires Zone:DNS:Edit permission."
        }
      },
      {
        "key": "tencent_secret_id",
        "name": { "zh_CN": "腾讯云 SecretId", "en": "Tencent Cloud SecretId" },
        "type": "string"
      },
      {
        "key": "tencent_secret_key",
        "name": { "zh_CN": "腾讯云 SecretKey", "en": "Tencent Cloud SecretKey" },
        "type": "string"
      },
      {
        "key": "interval",
        "name": { "zh_CN": "检查间隔 (分钟)", "en": "Check Interval (minutes)" },
        "type": "number",
        "default": 5,
        "required": true
      },
      {
        "key": "notify",
        "name": { "zh_CN": "更新时发送通知", "en": "Notify on update" },
        "type": "switch",
        "default": false
      }
    ]
  },
  "pages": [
    {
      "file": "admin.html",
      "title": { "zh_CN": "DDNS 状态", "en": "DDNS Status" },
      "visibility": "admin"
    }
  ]
}
